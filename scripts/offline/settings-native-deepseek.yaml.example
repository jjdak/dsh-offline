# 仅适用于完整实现 DeepSeek Chat Completions 协议的内网服务。
llm-deepseek:
  apiKeyEnv: DEEPSEEK_API_KEY
  baseURL: http://REPLACE_MODEL_HOST:REPLACE_MODEL_PORT
  thinking: enabled
  reasoningEffort: high
  maxTokens: 8192
  defaultContextWindow: 131072
  models:
    - id: REPLACE_MODEL_ID
      name: 内网 DeepSeek
      contextWindow: 131072
      maxTokens: 8192

agent-default-model:
  provider: deepseek-official
  model: REPLACE_MODEL_ID
  reasoningEffort: high
